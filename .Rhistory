prior_mu_b2=0, prior_se_b2=10, trunc_a_b2=0),
c(fun="sigmoidal", edge="CO2~pH",
prior_mu_b0=60, prior_se_b0=30, trunc_a_b0=0,
prior_mu_b1=6, prior_se_b1=2,
prior_mu_b2=-0.5, prior_se_b2=1),
c(fun="logit", edge="CO2onlyuser~HCO3", trans="log",
prior_mu_b0=0, prior_se_b0=10,

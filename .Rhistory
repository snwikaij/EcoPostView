b1[which.max(calc_w(actual[,2], lambda = 10000)*b1)]
plot(x, y)
abline(a=sum(calc_w(actual[,1])*b0), b=sum(calc_w(actual[,1])*b1), col="tomato3", lwd=2)
plot(x, y)

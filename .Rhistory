formula=list(c(fun="sigmoidal", edge="Chl~TP", trans="log",
prior_mu_b0=100, prior_se_b0=50, trunc_a_b0=0, trunc_b_b0=10000,
prior_mu_b1=6.2, prior_se_b1=1.6, trunc_a_b1=0,
prior_mu_b2=0, prior_se_b2=1, trunc_a_b2=0),
c(fun="log", edge="Macrophytes~Chl+Temp+CO2onlyuser", trans="log",
prior_mu_b0=3, prior_se_b0=0.25, trunc_a_b0=0,
prior_mu_b1=-0.3, prior_se_b1=0.1, trunc_b_b1=0,
prior_mu_b2=0.05, prior_se_b2=0.25,
prior_mu_b3=-0.05, prior_se_b3=0.025),
c(fun="class", edge="Characeae~Chl",
prior_mu_b0=5, prior_se_b0=5, trunc_a_b0=0,
prior_mu_b1=5, prior_se_b1=5, trunc_a_b1=0,
prior_mu_b2=50, prior_se_b2=100, trunc_a_b2=0,
prior_mu_b3=50, prior_se_b3=100, trunc_a_b3=0,
prior_mu_b4=0.4, prior_se_b4=0.05, trunc_a_b4=0, trunc_b_b4=1),
c(fun="sigmoidal", edge="pH~Chl",

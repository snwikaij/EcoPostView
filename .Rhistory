nsim   <- 1000
lambda <- 1000
b0 <- rnorm(nsim, -1, 1)
b1 <- rnorm(nsim , 1.5, 1)
bt0 <- -1.2
bt1 <- 0.98
x <- runif(100, 1, 150)
y <- rgamma(100, exp(bt0+bt1*log(x)), 1)
plot(x, y)
df <- data.frame(x,y)
yep <- lapply(1:nsim, function(i) {
residuals <- y-(b0[i]+b1[i]*x)
dfboot     <- df[sample(seq_len(nrow(df)), nrow(df), replace = T),]
resid_boot <- dfboot$y-(b0[i]+b1[i]*dfboot$x)
c(mean(residuals^2), mean(resid_boot^2))
})
actual  <- do.call(rbind, yep)
calc_w <- function(x, lambda){
act_mad <- actual[,1]/mad(x, constant = 1)
weights <- exp(-lambda*act_mad)
weights <- weights/sum(weights)
weights}
calc_w(actual[,1], lambda)*b1
b1[which.max(calc_w(actual[,2], lambda = 10000)*b1)]
plot(x, y)
abline(a=sum(calc_w(actual[,1])*b0), b=sum(calc_w(actual[,1])*b1), col="tomato3", lwd=2)

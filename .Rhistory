#Set priors for TP and Temp
prior        <- data.frame(TP = rgamma(3000, 80^2/100^2, 80/100^2),
Temp = c(rbeta(3000, 1.5, 3.5)*40))
prior$Temp   <- prior$Temp+(1-(prior$Temp/40))*4
ggplot(prior, aes(TP))+
geom_histogram()
ggplot(prior, aes(TP))+
geom_histogram(col="black", fill="grey80", alph=0.3)+
theme_classic()
ggplot(prior, aes(Temp))+
geom_histogram(col="black", fill="grey80", alph=0.3)+
theme_classic()
cowplot::plot_grid(
ggplot(prior, aes(TP))+
geom_histogram(col="black", fill="grey80", alph=0.3)+
theme_classic(),
ggplot(prior, aes(Temp))+
geom_histogram(col="black", fill="grey80", alph=0.3)+
theme_classic(),
ncol=2)
cowplot::plot_grid(
ggplot(prior, aes(TP))+
geom_histogram(col="black", fill="grey80", alph=0.3, bins=20)+
theme_classic(),
ggplot(prior, aes(Temp))+
geom_histogram(col="black", fill="grey80", alph=0.3, bins=20)+
theme_classic(),
ncol=2)
cowplot::plot_grid(
ggplot(prior, aes(TP))+
geom_histogram(col="black", fill="grey80", alph=0.3, bins=15)+
theme_classic(),
ggplot(prior, aes(Temp))+
geom_histogram(col="black", fill="grey80", alph=0.3, bins=15)+
theme_classic(),
ncol=2)
ggplot(prior, aes(TP, Temp))+
geom_point()
ggplot(prior, aes(log(TP), log(Temp)))+
geom_point()
#Display the prior distributions
cowplot::plot_grid(
ggplot(prior, aes(TP))+
geom_histogram(col="black", fill="grey80", alph=0.3, bins=15)+
theme_classic(),
ggplot(prior, aes(Temp))+
geom_histogram(col="black", fill="grey80", alph=0.3, bins=15)+
theme_classic(),
ncol=2)

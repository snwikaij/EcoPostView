colnames(binned)[1] <- "Distance"
Apl <- setNames(aggregate(Cover ~ cut(Distance, breaks=seq(0, 1000, length.out=21)), yep2, mean), c("Distance", "Cover"))
#Bpl <- setNames(aggregate(Cover ~ cut(AssemblageN, breaks=seq(5, 100, length.out=20)), yep2, mean), c("N", "Cover"))
Cpl <- setNames(aggregate(Cover ~ cut(D, breaks=seq(0, 1, length.out=21)), yep2, mean), c("D", "Cover"))
Dpl <- setNames(aggregate(Cover ~ cut(Score, breaks=seq(0, 1, length.out=21)), yep2, mean), c("Score", "Cover"))
cowplot::plot_grid(
ggplot(Apl, aes(Distance, Cover))+
geom_point()+
theme_classic()+
theme(axis.text.x = element_text(angle = 90, hjust=1)),
#ggplot(Bpl, aes(N, Cover))+
#  geom_point()+
#  theme_classic()+
#  theme(axis.text.x = element_text(angle = 90, hjust=1)),
ggplot(Cpl, aes(D, Cover))+
geom_point()+
theme_classic()+
theme(axis.text.x = element_text(angle = 90, hjust=1)),
ggplot(Dpl, aes(Score, Cover))+
geom_point()+
theme_classic()+
theme(axis.text.x = element_text(angle = 90, hjust=1)),
labels="AUTO", ncol=2)
lower_plots <- function(data, mapping, ...) {
ggplot(data = data, mapping = mapping) +
geom_point(color = "black", alpha = 0.15) +
geom_smooth(method = "gam", ...) +
theme_classic()
}
p <- GGally::ggpairs(
data.table(yep[, -c(1, 8)]),
diag = list(
continuous = wrap(
"barDiag",
bins = 20,
fill = "grey70",
colour = "black"
)
),
lower = list(
continuous = wrap(
lower_plots,
alpha = 0.15,
pch = 21,
color = "tomato3",
se = FALSE
)
),
upper = list(
continuous = wrap(
"cor",
method = "spearman",
title = "Cor",
stars = FALSE,
size = 6
)
)
)
for (i in seq_len(p$nrow)) {
for (j in seq_len(p$ncol)) {
p[i, j] <- p[i, j] + theme_classic()
}
}
p

nsim      <- 1000
perf_list <- vector("list", nsim)
test_party <- function(munb, sdnb, nt, mus, sds) {
df_long <- do.call(rbind, lapply(seq_along(mus), function(i){data.frame(
taxon = paste0("V", i), x = rnorm(nt[i], mus[i], sds[i]))}))
resolution <- runif(1, 0.01, 0.05)
df_long$x  <- round(df_long$x/resolution)*resolution
df_long$y <- rnbinom(n = nrow(df_long), mu = munb, size = munb^2 / (sdnb^2 - munb))
df_wide   <- pivot_wider(df_long, id_cols = x, names_from = taxon, values_from = y, values_fill = 0, values_fn = sum)
test                   <- party_point(exp(df_wide$x),
df_wide[, -1],
n_cores = 10,
nsim = 1000,
stop_cl = T,
method = "weighted",
compile_curves = F)
test$summary$taxon     <- factor(test$summary$taxon, levels = paste0("V", seq_along(mus)))
test$summary           <- test$summary[order(test$summary$taxon),]
rownames(test$summary) <- NULL
true_D_loc <- function(j, mus, sds,grid = seq(4, 8, length.out = 10000)){
F_taxa <- vapply(seq_along(mus),function(k){pnorm(grid, mean = mus[k], sd = sds[k])}, numeric(length(grid)))
F_pool <- rowMeans(F_taxa)
F_j    <- pnorm(grid, mean = mus[j], sd = sds[j])
grid[which.max(abs(F_pool - F_j))]}
test$summary$true_loc     <- exp(vapply(seq_along(mus), true_D_loc, numeric(1), mus = mus, sds = sds))
test$summary$cover        <- ifelse(test$summary$true_loc >= test$summary$ll_location & test$summary$true_loc <= test$summary$ul_location, 1, 0)
test$summary$error        <- test$summary$location-test$summary$true_loc
test$summary$dist_geom_mu <- taxon_mode - assemblage_mode
test$summary$z            <- test$summary$error/test$summary$se_location
test$summary$groupN       <- length(mus)
testdf <- test$summary[c("location", "D", "Score", "z", "se_location", "n", "true_loc", "error", "dist_geom_mu")]
test$summary}
for(i in seq_len(nsim)){
message(i)
mus   <- seq(4.6, 7.5, runif(1, 0.049, 0.7)) #between 5 and 60
sds   <- runif(length(mus), 0.1, 0.3)
munb  <- 100
sdnb  <- 80
nt    <- sample(c(5:100), length(mus))
#assemblage_mode <- assemblage_mode_approx <- exp(mean(mus - sds^2))
x <- seq(min(taxon_mode) / 2,
max(taxon_mode) * 2,
length.out = 5000)
dens <- sapply(x, function(xx)
mean(dlnorm(xx, meanlog = mus, sdlog = sds)))
assemblage_mode <- x[which.max(dens)]
taxon_mode      <- exp(mus-sds^2)
perf_list[[i]] <- data.frame(sim=i, test_party(munb = munb, sdnb = sdnb, nt = nt, mus = mus, sds = sds))}
yep <- do.call(rbind, perf_list)
yep <- yep[c("sim", "location", "D", "z", "Score", "n", "error", "cover", "dist_geom_mu", "se_location")]
colnames(yep) <- c("Simulation", "Location", "D", "Z", "Score", "N", "Error", "Cover", "Distance", "SE")
yep$D         <- abs(yep$D)
sum(yep$Cover)/nrow(yep)
yep2   <- yep[yep$Distance < 1000,]
binned <- yep
colnames(binned)[1] <- "Distance"
Apl <- setNames(aggregate(Cover ~ cut(Distance, breaks=seq(0, 1000, length.out=21)), yep2, mean), c("Distance", "Cover"))
Cpl <- setNames(aggregate(Cover ~ cut(D, breaks=seq(0, 1, length.out=21)), yep2, mean), c("D", "Cover"))
Dpl <- setNames(aggregate(Cover ~ cut(Score, breaks=seq(0, 1, length.out=21)), yep2, mean), c("Score", "Cover"))
cowplot::plot_grid(
ggplot(Apl, aes(Distance, Cover))+
geom_point()+
theme_classic()+
theme(axis.text.x = element_text(angle = 90, hjust=1)),
ggplot(Cpl, aes(D, Cover))+
geom_point()+
theme_classic()+
theme(axis.text.x = element_text(angle = 90, hjust=1)),
ggplot(Dpl, aes(Score, Cover))+
geom_point()+
theme_classic()+
theme(axis.text.x = element_text(angle = 90, hjust=1)),
labels="AUTO", ncol=3)

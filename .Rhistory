ggplot(data = data, mapping = mapping) +
geom_point(color = "black", alpha = 0.15) +
geom_smooth(method = "gam", ...) +
theme_classic()
}
p <- GGally::ggpairs(
data.table(yep[, -c(1, 8)]),
diag = list(
continuous = wrap(
"barDiag",
bins = 20,
fill = "grey70",
colour = "black"
)
),
lower = list(
continuous = wrap(
lower_plots,
alpha = 0.15,
pch = 21,
color = "tomato3",
se = FALSE
)
),
upper = list(
continuous = wrap(
"cor",
method = "spearman",
title = "Cor",
stars = FALSE,
size = 6
)
)
)
for (i in seq_len(p$nrow)) {
for (j in seq_len(p$ncol)) {
p[i, j] <- p[i, j] + theme_classic()
}
}
